# Pod Passport Scanner — TestFlight delivery.
#
# Auth is keyless: an App Store Connect API key (App Manager role) provided via
# env, so no Apple ID password / 2FA in CI. Signing is resolved by Xcode at
# archive time (`-allowProvisioningUpdates` + the same API key), so there is no
# fastlane match repo to maintain — the only state is the four CI secrets.
#
# Required env (set as GitHub Actions secrets — see .github/workflows/ios-testflight.yml):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (base64 of the .p8), APPLE_TEAM_ID
#
# Run locally:  ASC_KEY_ID=… ASC_ISSUER_ID=… ASC_KEY_P8=… APPLE_TEAM_ID=… fastlane beta

default_platform(:ios)

PROJECT = "PodPassportScanner.xcodeproj"
SCHEME  = "PodPassportScanner"

platform :ios do
  desc "Build a signed Release archive and upload it to TestFlight"
  lane :beta do
    # Temp keychain + non-interactive settings on CI.
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false,
    )

    # Regenerate the Xcode project from project.yml (source of truth).
    sh("command -v xcodegen >/dev/null && (cd .. && xcodegen generate) || true")

    # Monotonic build number from the CI run; falls back to a bump locally.
    build = ENV["GITHUB_RUN_NUMBER"]
    increment_build_number(xcodeproj: PROJECT, build_number: build) if build

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      # Let Xcode create/refresh the distribution cert + profile via the API key.
      xcargs: "-allowProvisioningUpdates",
      export_options: {
        teamID: ENV.fetch("APPLE_TEAM_ID", "7J8623FGRC"),
        signingStyle: "automatic",
      },
      output_directory: "build",
      output_name: "PodPassportScanner.ipa",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      # Internal testers (≤100, on the team) need no Beta App Review; add them in
      # App Store Connect → TestFlight after the first build finishes processing.
    )
  end
end
